# Salin file ini menjadi .env lalu isi:  cp env.example .env
# JANGAN bagikan file .env ke siapa pun.

# Token dari Meta Developer (Buat Token Akses). Setelah bot jalan pertama kali,
# token disimpan & diperpanjang otomatis di token.json.
THREADS_ACCESS_TOKEN=tempel_token_threads_di_sini

# Untuk `python bot.py login` (token dengan izin lengkap, termasuk mentions).
# Ambil dari Meta Developer > Use cases > Access the Threads API > Settings.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://localhost/
# true = minta juga threads_keyword_search (harus sudah ditambahkan di dashboard)
MINTA_KEYWORD_SEARCH=false

# Integrasi AI (gateway kompatibel OpenAI: bankai.web.id), sama seperti wabot-app.
# Chat dikirim ke {AI_BASE_URL}/v1/chat/completions
AI_BASE_URL=https://bankai.web.id/api
AI_API_KEY=tempel_api_key_bankai_di_sini
AI_MODEL=deepseek-v4.1-flash

# true = hanya simulasi (tidak memposting). Ubah ke false kalau hasilnya sudah oke.
DRY_RUN=true

# Balas komentar
MAX_BALAS_PER_JALAN=8
MAX_BALAS_PER_ORANG=3
UMUR_KOMENTAR_MAKS_JAM=48
JUMLAH_POST_DIPANTAU=5
BALAS_MENTION=true

# Cari post orang lain (hasilnya jadi draf, perlu disetujui manual)
KATA_KUNCI=analisis data,sistem informasi
MAX_DRAF_CARI=5
